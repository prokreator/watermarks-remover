# Copy to .env and fill in. Never commit .env.

# From @BotFather (step 2 of the README)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your personal chat id; run `python get_chat_id.py` to find it (step 3)
TELEGRAM_CHAT_ID=

# The AXS UK event page that shows resale listings for your show
AXS_EVENT_URL=https://www.axs.com/uk/events/000000/your-show-tickets

# Comma-separated words that identify the ticket type you want (case-insensitive)
MATCH_KEYWORDS=standing,general admission
# Optional: ignore listings above this many pounds (per ticket as shown on the page)
MAX_PRICE=

# Seconds between checks (minimum 30) plus random extra 0..CHECK_JITTER seconds
CHECK_INTERVAL=60
CHECK_JITTER=20

# Set to false to watch the browser window (useful for first login / solving a check)
HEADLESS=true
